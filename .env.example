# Mycelium — Environment Variables
# Copy this file to .env and fill in the values.

# Required: JWT signing secret for dashboard authentication
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Required: Admin API key for privileged operations
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=

# Optional: Server port (default: 3002)
# PORT=3002

# Optional: Database and file storage directory (default: server/data/)
# Only set this if you have a persistent volume mounted (e.g. Railway volume at /data)
# Setting DATA_DIR=/data without a volume will crash on startup (EACCES)
# DATA_DIR=/data

# Optional: WebRTC TURN secret for voice chat
# Without this, a public relay is used (fine for development, not for production)
# TURN_SECRET=

# Optional: canonical public URL of this instance (no trailing slash).
# When set, used verbatim for MCP/instance URLs instead of deriving from the Host header.
# PUBLIC_BASE_URL=https://mycelium.example.com

# Optional: comma-separated allowlist of permitted Host header values (host-header hardening).
# When set, requests whose Host isn't listed are rejected. Unset = any Host allowed.
# ALLOWED_HOSTS=mycelium.example.com,localhost

# Optional: Resend API key for transactional email. Unset = email disabled.
# RESEND_KEY=re_xxxxxxxx

# Optional: GitHub PAT for the /github/* proxy so agents need no token of their own.
# Unset = unauthenticated (lower GitHub rate limit).
# GITHUB_TOKEN=ghp_xxxxxxxx

# Optional: server-side Anthropic keys for admin endpoints (API-limit probe; org usage).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_ADMIN_KEY=sk-ant-admin-xxxxxxxx

# Optional: Set to production for deployed instances
# NODE_ENV=production
