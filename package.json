{
  "name": "mycelium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mycelium — distributed development platform.",
  "author": "SoftBacon Software",
  "license": "Apache-2.0",
  "repository": "https://github.com/SoftBacon-Software/mycelium",
  "homepage": "https://mycelium.fyi",
  "workspaces": [
    "mcp",
    "runner",
    "printer-drone",
    "sdk"
  ],
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "start:mcp": "node mcp/index.js",
    "start:runner": "node runner/index.js",
    "start:printer": "node printer-drone/index.js",
    "start:printer:mock": "node printer-drone/index.js --mock",
    "test": "npm run test:unit && npm run test:plugins",
    "test:unit": "vitest run",
    "test:plugins": "if ls server/plugins/*/test.js >/dev/null 2>&1; then node --test server/plugins/*/test.js; else echo 'No plugin test files found — skipping'; fi",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint server sdk test --max-warnings 333",
    "lint:fix": "eslint server sdk test --fix",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "bonjour-service": "^1.4.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "googleapis": "^171.4.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.0",
    "resend": "^6.9.3",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "body-parser": "^2.3.0",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23"
  }
}
